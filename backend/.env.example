# Copy to backend/.env for local development. Use Render env vars for deployment.
SIGNAL_PUBLIC_ORIGIN=http://localhost:8000
SIGNAL_DEMO_USERNAME=demo
SIGNAL_DEMO_PASSWORD=
SIGNAL_SESSION_SECRET=
# Optional path to the compiled Next.js static export.
SIGNAL_STATIC_DIR=

ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Optional comma-separated hostnames to focus research on approved public sources.
SIGNAL_DISCOVERY_DOMAINS=
HUNTER_API_KEY=
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Leave blank to use the instance's default database.
NEO4J_DATABASE=

# Gmail OAuth credentials for a mailbox you control, with gmail.send scope.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=
SIGNAL_TEST_RECIPIENT=
SIGNAL_SUPPRESSED_RECIPIENTS=

# Optional. Configure with real sandbox IDs and a pre-funded demo wallet.
FLEXPRICE_ENABLED=false
FLEXPRICE_BASE_URL=https://us.api.flexprice.io/v1
FLEXPRICE_API_KEY=
FLEXPRICE_CUSTOMER_ID=
FLEXPRICE_EXTERNAL_CUSTOMER_ID=
FLEXPRICE_WALLET_ID=
FLEXPRICE_ENRICHMENT_COST=1
# Enable after adding the matching sandbox meters. Off for the basic enrichment demo.
FLEXPRICE_METER_GRAPH_AND_OUTREACH=false

# Optional read-only Nexla Sync API. Expected response is documented in backend/README.md.
NEXLA_SYNC_URL=
NEXLA_ACCESS_TOKEN=
